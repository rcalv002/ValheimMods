<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework><Version>0.2.10</Version>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences><NoStdLib>true</NoStdLib>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="report.html" LogicalName="ValhallaMeter.report.html" />
    <ProjectReference Include="..\ValhallaMeter.Core\ValhallaMeter.Core.csproj" />
    <Reference Include="BepInEx"><HintPath>$(BepInExPath)\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExPath)\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="$(GameManaged)\*.dll"><Private>false</Private><ExternallyResolved>true</ExternallyResolved></Reference>
  </ItemGroup>
  <Target Name="CheckGame" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameManaged)\assembly_valheim.dll')" Text="Set ValheimPath to your Valheim install folder." />
    <Error Condition="!Exists('$(BepInExPath)\core\BepInEx.dll')" Text="Run scripts/prepare.ps1 or set BepInExPath to your BepInEx folder." />
  </Target>
</Project>
